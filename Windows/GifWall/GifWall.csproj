<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF and WinForms share many type names; every file imports what it needs explicitly. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WinForms is only used for the tray icon; DPI awareness comes from app.manifest for the whole process. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>GifWall</AssemblyName>
    <RootNamespace>GifWall</RootNamespace>
    <Product>GifWall</Product>
    <Company>GifWall</Company>
    <Version>1.0.0</Version>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="AppIcon.ico" />
    <!-- libmpv stays a separate file next to GifWall.exe (build.sh downloads it into Windows/lib). -->
    <None Include="..\lib\libmpv-2.dll" Link="libmpv-2.dll" Condition="Exists('..\lib\libmpv-2.dll')"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
