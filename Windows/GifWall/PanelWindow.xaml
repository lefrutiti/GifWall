<Window x:Class="GifWall.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GifWall" Width="320" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="False" Background="{DynamicResource Bg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="{DynamicResource Fg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="20" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{DynamicResource Secondary}" Background="Transparent"/>
                            <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0"
                                     Fill="{DynamicResource Secondary}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Knob" Property="Fill" Value="White"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
                                <Setter TargetName="Knob" Property="Width" Value="14"/>
                                <Setter TargetName="Knob" Property="Height" Value="14"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="Transparent" CornerRadius="4" Padding="6,3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Row" TargetType="Button" BasedOn="{StaticResource Link}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <StackPanel Margin="16">
            <!-- Header -->
            <DockPanel>
                <CheckBox x:Name="EnabledSwitch" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Switch}"
                          Click="EnabledSwitch_Click"/>
                <StackPanel>
                    <TextBlock Text="Живые обои" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StatusText" FontSize="11" Foreground="{DynamicResource Secondary}"/>
                </StackPanel>
            </DockPanel>

            <!-- Preview -->
            <Grid x:Name="PreviewBox" Height="176" Margin="0,14,0,0" Cursor="Hand" AllowDrop="True"
                  MouseLeftButtonUp="Preview_Click" DragEnter="Preview_DragEnter" DragOver="Preview_DragEnter"
                  DragLeave="Preview_DragLeave" Drop="Preview_Drop">
                <Border CornerRadius="10" Background="{DynamicResource Well}"/>
                <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Secondary}"/>
                    <TextBlock Text="Перетащите видео или GIF" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Secondary}"/>
                    <TextBlock Text="MP4 · MOV · WebM · GIF · WebP · APNG · ZIP" FontSize="10" Margin="0,2,0,0"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Tertiary}"/>
                </StackPanel>
                <Border x:Name="PreviewClip" CornerRadius="10" ClipToBounds="True">
                    <Image x:Name="PreviewImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <Border x:Name="DropBorder" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Accent}" Visibility="Collapsed"/>
            </Grid>
            <StackPanel x:Name="BusyPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                <ProgressBar IsIndeterminate="True" Width="60" Height="3" VerticalAlignment="Center"
                             Foreground="{DynamicResource Accent}" Background="Transparent" BorderThickness="0"/>
                <TextBlock x:Name="BusyText" FontSize="11" Margin="8,0,0,0" Foreground="{DynamicResource Secondary}"/>
            </StackPanel>

            <TextBlock x:Name="SourceText" FontSize="11" Margin="0,8,0,0" Foreground="{DynamicResource Secondary}"
                       TextTrimming="CharacterEllipsis"/>

            <!-- Archive picker -->
            <StackPanel x:Name="ArchivePanel" Margin="0,8,0,0" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Отмена" FontSize="11" Style="{StaticResource Link}"
                            Foreground="{DynamicResource Secondary}" Click="CancelArchive_Click"/>
                    <TextBlock Text="Файлы в архиве" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Secondary}"/>
                </DockPanel>
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ArchiveList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Row}" Click="ArchiveItem_Click" Tag="{Binding Path}">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                                   Width="18" VerticalAlignment="Center" Foreground="{DynamicResource Secondary}"/>
                                        <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

            <!-- Settings -->
            <StackPanel x:Name="SettingsPanel" Margin="0,12,0,0">
                <DockPanel Margin="0,0,0,10">
                    <CheckBox x:Name="DesktopSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="DesktopSwitch_Click"/>
                    <TextBlock Text="Рабочий стол" VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,10">
                    <CheckBox x:Name="LockSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="LockSwitch_Click"/>
                    <StackPanel>
                        <TextBlock Text="Экран блокировки"/>
                        <TextBlock Text="Первый кадр — Windows не анимирует экран блокировки" FontSize="10"
                                   Foreground="{DynamicResource Tertiary}" TextWrapping="Wrap" Margin="0,1,8,0"/>
                    </StackPanel>
                </DockPanel>
                <DockPanel>
                    <CheckBox x:Name="LoginSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" Click="LoginSwitch_Click"/>
                    <TextBlock Text="Запуск при входе" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>

            <TextBlock x:Name="WarningText" FontSize="11" Margin="0,10,0,0" Foreground="#E08A00" TextWrapping="Wrap" Visibility="Collapsed"/>
            <TextBlock x:Name="ErrorText" FontSize="11" Margin="0,10,0,0" Foreground="#E5484D" TextWrapping="Wrap" Visibility="Collapsed"/>

            <Border Height="1" Background="{DynamicResource Border}" Margin="0,14,0,10"/>

            <DockPanel TextElement.FontSize="12">
                <Button DockPanel.Dock="Right" Content="Выйти" Style="{StaticResource Link}"
                        Foreground="{DynamicResource Secondary}" Click="Quit_Click"/>
                <Button x:Name="ChooseButton" Content="Выбрать файл…" Style="{StaticResource Link}" HorizontalAlignment="Left"
                        Margin="-6,0,0,0" Click="Choose_Click"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
